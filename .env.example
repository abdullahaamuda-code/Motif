# =============================================
# MOTIF — environment variables (all server-side)
# =============================================

# --- AI Director (multi-key rotation) ---
# Add up to 8 each: CEREBRAS_API_KEY_1, CEREBRAS_API_KEY_2, ...
CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=

GROQ_API_KEY_1=
GROQ_API_KEY_2=
# (the extractor needs a GROQ key for vision)

# --- Quota hardening ---
APP_SECRET=put-a-long-random-string-here   # signs client quota tokens
CHAT_DAILY_LIMIT=50                        # free chats/day per visitor

# --- Admin panel (the SEPARATE project) ---
# The admin dashboard authenticates SUBMIT + NOTIFY calls against this secret.
# Pick a strong one. Never commit real keys.
ADMIN_SECRET=VERY-long-random-string-you-will-never-guess

# --- Where "Submit your design" flows ---
# Point at a free Formsbucket / Formspree / Brevo webhook, or your own
# Discord/Supabase/DB endpoint. Submissions are JSON-posted here.
SUBMIT_WEBHOOK=

# --- Push target (admin writes notify.txt + pushes via GitHub API) ---
# Admin panel needs ONLY these to trigger Vercel redeploys.
GITHUB_PAT=github_pat_...            # personal access token, repo scope, write
GITHUB_REPO=you/motif                # e.g. abdulscodes/motif
VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/...  # found in Vercel → Settings → Git → Deploy Hooks
